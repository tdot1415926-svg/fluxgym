# Runtime image for FluxGym training with CUDA 12.4.
FROM nvidia/cuda:12.4.1-base-ubuntu22.04

ARG PUID=1000
ARG PGID=1000

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    git \
    build-essential && \
    rm -rf /var/lib/apt/lists/*

# A non-root user keeps bind-mounted models and outputs writable on Linux hosts.
RUN groupadd -g "${PGID}" appuser && \
    useradd -m -s /bin/sh -u "${PUID}" -g "${PGID}" appuser

WORKDIR /app/fluxgym

# Pin the CUDA-matched Torch stack before installing packages that depend on it.
RUN pip install --no-cache-dir torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu124

# FluxGym imports library and train_network directly from sd-scripts at runtime,
# so this directory must remain in the final image.
RUN git clone --depth 1 -b sd3 https://github.com/kohya-ss/sd-scripts && \
    pip install --no-cache-dir --prefer-binary -r sd-scripts/requirements.txt

COPY requirements.txt ./requirements.txt
# The legacy FluxGym dependency list contains loose and overlapping pins. The
# compatibility resolver avoids the exhaustive resolver's ResolutionTooDeep
# failure while preserving the CUDA Torch stack installed above.
RUN pip install --no-cache-dir --use-deprecated=legacy-resolver -r requirements.txt

COPY . .
RUN mkdir -p models/unet models/vae models/clip outputs && \
    chown -R appuser:appuser /app/fluxgym

USER appuser

EXPOSE 7860
ENV GRADIO_SERVER_NAME=0.0.0.0 \
    PYTHONUNBUFFERED=1

CMD ["python3", "app.py"]
